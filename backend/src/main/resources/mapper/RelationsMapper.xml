<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://www.mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartcare.mapper.RelationsMapper">

    <resultMap id="RelationVoMap" type="com.smartcare.vo.relation.RelationVo">
        <id property="relationId" column="relation_id"/>
        <result property="relationship" column="relationship"/>
        <result property="realName" column="real_name"/>
        <result property="phone" column="phone"/>
    </resultMap>

    <resultMap id="ElderRelativeVoMap" type="com.smartcare.vo.elder.ElderRelativeVo">
        <id property="relationId" column="relation_id"/>
        <result property="userId" column="user_id"/>
        <result property="relationship" column="relationship"/>
        <result property="realName" column="real_name"/>
        <result property="phone" column="phone"/>
    </resultMap>

    <select id="selectRelationPage" resultMap="RelationVoMap">
        SELECT
        r.relation_id,
        r.relationship,
        u.real_name,
        u.phone
        FROM relations r
        LEFT JOIN users u ON r.user_id = u.user_id
        WHERE r.elder_id = #{elderId}
        ORDER BY r.relation_id DESC
    </select>

    <select id="selectRelativeListByElderId" resultMap="ElderRelativeVoMap">
        SELECT
        r.relation_id,
        r.user_id,
        r.relationship,
        u.real_name,
        u.phone
        FROM relations r
        LEFT JOIN users u ON r.user_id = u.user_id
        WHERE r.elder_id = #{elderId}
        ORDER BY r.relation_id ASC
    </select>

    <!-- 校验家属和老人是否存在绑定关系 -->
    <select id="countFamilyElderRelation" resultType="int">
        SELECT COUNT(1)
        FROM relations
        WHERE user_id = #{userId}
        AND elder_id = #{elderId}
    </select>

    <!-- 删除家属与老人的绑定关系 -->
    <delete id="deleteFamilyElderRelation">
        DELETE FROM relations
        WHERE user_id = #{userId}
        AND elder_id = #{elderId}
    </delete>

</mapper>